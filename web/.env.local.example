# Copia a .env.local. Nunca subas valores reales (arquitectura.md §2.4).
# Ninguna variable lleva NEXT_PUBLIC_: el navegador no habla con Supabase.

# API de Supabase (local: gateway del CLI). `pnpm db:env` las rellena.
SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_...; baja confianza, la RLS manda.
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...; solo servidor, nunca en el navegador.
SUPABASE_SECRET_KEY=
# Postgres directo; solo scripts y pruebas.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Pooler de sesión (5432); SOLO en Production de Vercel. Déjala vacía en local.
SUPABASE_DB_URL_MIGRACIONES=

# Secreto del hook de SMS de Supabase, formato v1,whsec_...
SEND_SMS_HOOK_SECRET=
# stub (solo LT_ENV=local) | sandbox | live
SMS_PROVIDER_MODE=stub
# Vacía en local (modo stub).
SMSMASIVOS_API_KEY=
# Vacía en local (el correo va a Mailpit, puerto 54324).
RESEND_API_KEY=
# Dónde llegan los avisos del hook y del cron.
ALERT_EMAIL_TO=
# Aleatoria; HMAC de la IP en envio_codigo.
IP_HASH_PEPPER=
# Aleatoria; Vercel la manda como Authorization: Bearer.
CRON_SECRET=

# local | preview | production
LT_ENV=local
# 1 con HTTPS; 0 solo en HTTP de Chrome (WebKit no acepta Secure por HTTP).
LT_COOKIE_SECURE=1

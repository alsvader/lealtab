{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "LealTab Design Tokens — Fase 4 · pieza 1. Hexes aprobados en paleta-y-tipografia.md + Ciclo v2.",
  "color": {
    "lino": {
      "$value": "#F3EFE6",
      "$type": "color",
      "$description": "Fondo principal"
    },
    "blanco-lino": {
      "$value": "#FFFDF8",
      "$type": "color",
      "$description": "Superficie"
    },
    "noche": {
      "$value": "#0F2A22",
      "$type": "color",
      "$description": "Texto, bordes, sombras"
    },
    "bosque": {
      "$value": "#0F4D3A",
      "$type": "color",
      "$description": "Marca / primario"
    },
    "menta": {
      "$value": "#CFE3D6",
      "$type": "color",
      "$description": "Apoyo"
    },
    "durazno": {
      "$value": "#FF9F6E",
      "$type": "color",
      "$description": "Acento pequeño / recompensa"
    },
    "gris-noche": {
      "$value": "#4D635A",
      "$type": "color",
      "$description": "Texto secundario"
    },
    "tostado": {
      "$value": "#A8461A",
      "$type": "color",
      "$description": "Estado riesgo (texto)"
    },
    "durazno-claro": {
      "$value": "#FFE6D8",
      "$type": "color",
      "$description": "Estado riesgo (fondo)"
    },
    "rojo": {
      "$value": "#B42318",
      "$type": "color",
      "$description": "Estado error (texto)"
    },
    "rosa-claro": {
      "$value": "#FDECEA",
      "$type": "color",
      "$description": "Estado error (fondo)"
    },
    "bg": {
      "$value": "{color.lino}",
      "$type": "color"
    },
    "surface": {
      "$value": "{color.blanco-lino}",
      "$type": "color"
    },
    "text": {
      "$value": "{color.noche}",
      "$type": "color"
    },
    "text-muted": {
      "$value": "{color.gris-noche}",
      "$type": "color"
    },
    "text-on-bosque": {
      "$value": "{color.lino}",
      "$type": "color"
    },
    "border": {
      "$value": "{color.noche}",
      "$type": "color"
    },
    "shadow": {
      "$value": "{color.noche}",
      "$type": "color"
    },
    "brand": {
      "$value": "{color.bosque}",
      "$type": "color"
    },
    "accent": {
      "$value": "{color.durazno}",
      "$type": "color"
    },
    "support": {
      "$value": "{color.menta}",
      "$type": "color"
    },
    "success": {
      "$value": "{color.bosque}",
      "$type": "color"
    },
    "success-bg": {
      "$value": "{color.menta}",
      "$type": "color"
    },
    "risk": {
      "$value": "{color.tostado}",
      "$type": "color"
    },
    "risk-bg": {
      "$value": "{color.durazno-claro}",
      "$type": "color"
    },
    "error": {
      "$value": "{color.rojo}",
      "$type": "color"
    },
    "error-bg": {
      "$value": "{color.rosa-claro}",
      "$type": "color"
    }
  },
  "font": {
    "family": {
      "display": {
        "$value": "Archivo, \"Arial Narrow\", sans-serif",
        "$type": "fontFamily"
      },
      "body": {
        "$value": "Manrope, system-ui, sans-serif",
        "$type": "fontFamily"
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      },
      "black": {
        "$value": 800,
        "$type": "fontWeight"
      }
    },
    "width": {
      "condensed": {
        "$value": "75%",
        "$description": "Archivo wdth 75"
      }
    },
    "size": {
      "display": {
        "$value": "96px",
        "$type": "dimension"
      },
      "h1": {
        "$value": "64px",
        "$type": "dimension"
      },
      "h2": {
        "$value": "44px",
        "$type": "dimension"
      },
      "h3": {
        "$value": "32px",
        "$type": "dimension"
      },
      "h4": {
        "$value": "24px",
        "$type": "dimension"
      },
      "lead": {
        "$value": "20px",
        "$type": "dimension"
      },
      "body": {
        "$value": "16px",
        "$type": "dimension"
      },
      "ui": {
        "$value": "14px",
        "$type": "dimension"
      },
      "caption": {
        "$value": "12px",
        "$type": "dimension"
      },
      "label": {
        "$value": "11px",
        "$type": "dimension"
      },
      "stat": {
        "$value": "32px",
        "$type": "dimension"
      },
      "sticker-sm": {
        "$value": "11px",
        "$type": "dimension"
      },
      "sticker": {
        "$value": "13px",
        "$type": "dimension"
      },
      "sticker-lg": {
        "$value": "15px",
        "$type": "dimension"
      }
    },
    "lineHeight": {
      "display": {
        "$value": 0.9,
        "$type": "number"
      },
      "h1": {
        "$value": 0.92,
        "$type": "number"
      },
      "h2": {
        "$value": 0.95,
        "$type": "number"
      },
      "h3": {
        "$value": 1,
        "$type": "number"
      },
      "h4": {
        "$value": 1.05,
        "$type": "number"
      },
      "lead": {
        "$value": 1.5,
        "$type": "number"
      },
      "body": {
        "$value": 1.55,
        "$type": "number"
      },
      "ui": {
        "$value": 1.45,
        "$type": "number"
      },
      "caption": {
        "$value": 1.4,
        "$type": "number"
      },
      "label": {
        "$value": 1.3,
        "$type": "number"
      },
      "stat": {
        "$value": 1.1,
        "$type": "number"
      }
    },
    "letterSpacing": {
      "label": {
        "$value": "0.12em",
        "$type": "dimension"
      },
      "stat": {
        "$value": "-0.02em",
        "$type": "dimension"
      },
      "sticker": {
        "$value": "0.02em",
        "$type": "dimension"
      }
    }
  },
  "space": {
    "1": {
      "$value": "4px",
      "$type": "dimension"
    },
    "2": {
      "$value": "8px",
      "$type": "dimension"
    },
    "3": {
      "$value": "12px",
      "$type": "dimension"
    },
    "4": {
      "$value": "16px",
      "$type": "dimension"
    },
    "5": {
      "$value": "24px",
      "$type": "dimension"
    },
    "6": {
      "$value": "32px",
      "$type": "dimension"
    },
    "7": {
      "$value": "48px",
      "$type": "dimension"
    },
    "8": {
      "$value": "64px",
      "$type": "dimension"
    }
  },
  "radius": {
    "sticker": {
      "$value": "6px",
      "$type": "dimension"
    },
    "control": {
      "$value": "10px",
      "$type": "dimension"
    },
    "card": {
      "$value": "14px",
      "$type": "dimension"
    },
    "container": {
      "$value": "24px",
      "$type": "dimension"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension"
    }
  },
  "border": {
    "hair": {
      "$value": "1.5px",
      "$type": "dimension"
    },
    "product": {
      "$value": "2px",
      "$type": "dimension"
    },
    "product-strong": {
      "$value": "2.5px",
      "$type": "dimension"
    },
    "marketing": {
      "$value": "3px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "sticker": {
      "$value": {
        "offsetX": "3px",
        "offsetY": "3px",
        "blur": "0",
        "spread": "0",
        "color": "{color.shadow}"
      },
      "$type": "shadow"
    },
    "button": {
      "$value": {
        "offsetX": "4px",
        "offsetY": "4px",
        "blur": "0",
        "spread": "0",
        "color": "{color.shadow}"
      },
      "$type": "shadow"
    },
    "card": {
      "$value": {
        "offsetX": "5px",
        "offsetY": "5px",
        "blur": "0",
        "spread": "0",
        "color": "{color.shadow}"
      },
      "$type": "shadow"
    },
    "social": {
      "$value": {
        "offsetX": "6px",
        "offsetY": "6px",
        "blur": "0",
        "spread": "0",
        "color": "{color.shadow}"
      },
      "$type": "shadow"
    },
    "storefront": {
      "$value": {
        "offsetX": "8px",
        "offsetY": "8px",
        "blur": "0",
        "spread": "0",
        "color": "{color.shadow}"
      },
      "$type": "shadow"
    }
  },
  "duration": {
    "fast": {
      "$value": "150ms",
      "$type": "duration"
    },
    "ui": {
      "$value": "200ms",
      "$type": "duration"
    },
    "arc": {
      "$value": "600ms",
      "$type": "duration",
      "$description": "Centro del rango 500–700 ms"
    }
  },
  "easing": {
    "standard": {
      "$value": [
        0.2,
        0.8,
        0.2,
        1
      ],
      "$type": "cubicBezier"
    }
  },
  "grid": {
    "columns": {
      "desktop": {
        "$value": 12,
        "$type": "number"
      },
      "mobile": {
        "$value": 4,
        "$type": "number"
      }
    },
    "gutter": {
      "desktop": {
        "$value": "{space.5}",
        "$type": "dimension"
      },
      "mobile": {
        "$value": "{space.4}",
        "$type": "dimension"
      }
    }
  }
}
